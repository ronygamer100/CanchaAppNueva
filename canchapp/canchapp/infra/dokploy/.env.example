# URL publica, sin barra final. Ejemplo: https://fubito.pe
APP_URL=https://fubito.example.com

POSTGRES_USER=fubito
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_LARGO
POSTGRES_DB=fubito

# Genere con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# No cambie esta llave después de guardar credenciales Culqi: también las cifra.
SECRET_KEY=CAMBIAR_POR_SECRETO_ALEATORIO_DE_64_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_UPLOAD_SIZE_MB=5
SEED_AREQUIPA_CATALOG=true

# Mismo Client ID Web usado en Google Cloud para el dominio APP_URL.
GOOGLE_CLIENT_ID=

# Opcional. Si quedan vacíos, las imágenes persisten en el volumen uploads_data.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

